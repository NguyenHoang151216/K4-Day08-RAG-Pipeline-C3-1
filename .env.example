# Sao chép file này thành `.env` rồi điền giá trị của RIÊNG BẠN.
# `.env` đã nằm trong .gitignore — KHÔNG BAO GIỜ commit key lên repo.
#
# Mỗi thành viên tự cấu hình nhà cung cấp LLM của mình, đừng dùng chung key.

# ─── LLM cho Task 10 (sinh câu trả lời) — cần nếu muốn chatbot trả lời ───────
# Ba biến dùng chung giao diện OpenAI-compatible nên cắm được vào Groq,
# OpenRouter, OpenAI, hoặc endpoint tự dựng.
#
#   Groq       : LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter : LLM_BASE_URL=https://openrouter.ai/api/v1   (có model đuôi ":free")
#   OpenAI     : LLM_BASE_URL=https://api.openai.com/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# Thiếu LLM_API_KEY thì chatbot vẫn chạy và vẫn hiện nguồn trích dẫn,
# chỉ không có câu văn do LLM viết.

# ─── Tuỳ chọn ────────────────────────────────────────────────────────────────
# Đổi embedding model (mặc định intfloat/multilingual-e5-small, 384 chiều).
# CHỈ đổi sang BAAI/bge-m3 nếu máy có torch >= 2.6: bge-m3 không có safetensors
# nên transformers 5.x chặn nạp trên torch cũ hơn (CVE-2025-32434).
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIM=1024

# OpenRouter key cho HyDE ở Task 5 (tuỳ chọn — HyDE mặc định tắt)
# OPENROUTER_API_KEY=

# PageIndex cho Task 8 (không có cũng được — đã có bản vectorless chạy local)
# PAGEINDEX_API_KEY=

# Jina cho Task 7 cross-encoder rerank (không bắt buộc — RRF không cần key)
# JINA_API_KEY=
